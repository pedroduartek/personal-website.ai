{
  "name": "@personal-website/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/set-last-updated.cjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "size": "size-limit",
    "cv": "vite-node scripts/cv/export-cv-data.ts && python scripts/cv/build_cv.py"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.4",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@size-limit/file": "^11.0.2",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "sharp": "^0.35.0",
    "size-limit": "^11.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.9"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "250 KB"
    },
    {
      "path": "dist/assets/*.css",
      "limit": "50 KB"
    }
  ]
}
